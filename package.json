    "ai": "^7.0.179",
    "convex": "^1.46.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tinyld": "^1.3.4",
    "vite": "^8.3.0"
  },

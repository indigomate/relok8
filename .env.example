# Browser configuration. Use the matching Clerk/Convex development instances locally.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY
VITE_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud

# Set the following in the Convex dashboard, not in Vercel/browser variables:
# CLERK_JWT_ISSUER_DOMAIN=https://YOUR_INSTANCE.clerk.accounts.dev
# ADMIN_USER_IDS=user_YOUR_ADMIN_ID
# GEMINI_API_KEY=...
# GEMINI_MODEL=your_enabled_model
# OPUS_MT_API_URL=https://your-opus-mt-service.example.com
# OPUS_MT_API_TOKEN=optional-private-service-token
# OPUS_MT_CACHE_VERSION=opus-mt-v1
# RESEND_API_KEY=...
# RESEND_FROM_EMAIL=Relok8 <updates@send.relok8.online>
# SUPPORT_EMAIL=support@relok8.online
# PUBLIC_APP_URL=https://relok8.online
# WHATSAPP_ACCESS_TOKEN=store_only_in_convex
# WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
# WHATSAPP_GRAPH_VERSION=vXX.X
# WHATSAPP_APP_SECRET=store_only_in_convex
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate_a_long_random_value
# WHATSAPP_DAILY_TEMPLATE_EN=relok8_daily_apartment_digest_en
# WHATSAPP_DAILY_TEMPLATE_PL=relok8_daily_apartment_digest_pl

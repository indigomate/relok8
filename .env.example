# ==============================================================================
# CONVEX BACKEND & DATABASE ENGINE (PRIMARY DATA LAYER)
# ==============================================================================
# 1. Run `npx convex dev` in your terminal or create a project at https://dashboard.convex.dev
# 2. Copy the deployment URL into VITE_CONVEX_URL below.
# 3. For client reactivity:
VITE_CONVEX_URL="https://your-deployment-name.convex.cloud"
CONVEX_DEPLOYMENT="dev:your-deployment-name"

# CONVEX BACKEND ACTIONS ENVIRONMENT VARIABLES:
# Set these in your Convex Dashboard (Settings -> Environment Variables)
# OR via terminal: `npx convex env set <KEY> <VALUE>`
#
# STRIPE ESCROW (Manual Capture 149 PLN + optional add-ons in convex/payments.ts):
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
#
# WHATSAPP CLOUD API (Landlord lease approval alerts in convex/whatsapp.ts):
WHATSAPP_TOKEN="your_meta_whatsapp_cloud_api_token"
WHATSAPP_PHONE_NUMBER_ID="your_meta_whatsapp_phone_number_id"
#
# GEMINI AI (Zero-tenant-effort AI proxy & embeddings in convex/aiMessages.ts):
GEMINI_API_KEY="your_gemini_api_key"

# ==============================================================================
# HOSTING & URLS
# ==============================================================================
# APP_URL: The URL where this applet is hosted.
APP_URL="https://relok8.online"

# ==============================================================================
# AUTHENTICATION (CLERK)
# ==============================================================================
VITE_CLERK_PUBLISHABLE_KEY="pk_live_YOUR_PRODUCTION_KEY"
VITE_CLERK_DEV_PUBLISHABLE_KEY="pk_test_YOUR_DEVELOPMENT_KEY"

# ==============================================================================
# TRANSACTIONAL EMAIL (RESEND)
# ==============================================================================
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
RESEND_FROM_EMAIL="Relok8 <notifications@relok8.online>"

# ==============================================================================
# LEGACY / MIGRATED (PREVIOUS SUPABASE LAYER)
# ==============================================================================
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"


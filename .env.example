# Browser configuration. Use the matching Clerk/Convex development instances locally.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY
VITE_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud

# Set the following in the Convex dashboard, not in Vercel/browser variables:
# CLERK_JWT_ISSUER_DOMAIN=https://YOUR_INSTANCE.clerk.accounts.dev
# ADMIN_USER_IDS=user_YOUR_ADMIN_ID
# GEMINI_API_KEY=...
# GEMINI_MODEL=your_enabled_model
# RESEND_API_KEY=...
# RESEND_FROM_EMAIL=Relok8 <notifications@your-domain>
# SUPPORT_EMAIL=your_support_mailbox
# APP_URL=https://your-app-domain
